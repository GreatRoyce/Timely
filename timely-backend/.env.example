PORT=5050
NODE_ENV=development
DBSTRING= mongodb+srv://<username>:<password>@<cluster>/Timely
JWT_SECRET=replace-with-strong-jwt-secret
JWT_EXPIRES_IN=15m

EMAIL=example@gmail.com
EMAILSECRET=replace-with-app-password

TEST_SECRET=replace-with-paystack-secret

# Comma-separated list. Leave empty to allow all origins in development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5050

# Optional Cloudinary config for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
